generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model admin {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  name       String   @db.VarChar(255)
  role       Role     @default(Admin)
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([email, is_deleted])
}

model vendor {
  id                           Int                 @id @default(autoincrement())
  formated_id                  String              @unique
  email                        String              @db.VarChar(255)
  password                     String              @db.VarChar(255)
  is_email_verified            Boolean             @default(true)
  pan_card_url                 String
  gst_number                   String?             @db.VarChar(15)
  gst_certificate_url          String
  approved_by                  Int?
  is_deleted                   Boolean             @default(false)
  status                       VendorStatus        @default(Pending)
  created_at                   DateTime            @default(now())
  updated_at                   DateTime            @default(now()) @updatedAt
  is_deleted_by                Int?
  is_gst_vendor                Boolean             @default(false)
  is_number_verified           Boolean             @default(true)
  agreement_status             Boolean             @default(false)
  signature_url                String?
  alternate_number             String              @db.VarChar(20)
  aadhar_card_url              String
  mobile_number                String              @db.VarChar(20)
  organization_certificate_url String
  organization_name            String              @db.VarChar(255)
  organization_type            OrganizationType
  pan_number                   String              @db.VarChar(100)
  representative_designation   String              @db.VarChar(100)
  representative_name          String              @db.VarChar(255)
  signature_type               SignatureType
  vendor_name                  String              @db.VarChar(255)
  vendor_profile_image_url     String
  service_ids                  Int[]
  bank_detail                  vendor_bank_detail?
  drivers                      driver[]
  vehicles                     vehicle[]
  orders                       order[]
  services                     service[]
  dispatches                   order_dispatch[]

  @@index([id, formated_id])
  @@index([email, is_deleted])
  @@index([mobile_number, is_deleted])
}

model vendor_bank_detail {
  id                           Int      @id @default(autoincrement())
  vendor_id                    Int      @unique
  account_number               String
  ifsc_code                    String
  bank_name                    String
  branch_name                  String
  account_holder_name          String
  created_at                   DateTime @default(now())
  updated_at                   DateTime @default(now()) @updatedAt
  passbook_or_cancel_check_url String
  vendor                       vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id])
}

model otp {
  number     String?  @db.VarChar(20)
  otp        String   @db.VarChar(6)
  expires_at DateTime
  email      String?  @db.VarChar(255)
  id         Int      @id @default(autoincrement())
  type       OtpType
  created_at DateTime @default(now())
}

model driver {
  id                      Int                @id @default(autoincrement())
  email                   String             @db.VarChar(255)
  password                String             @db.VarChar(255)
  is_email_verified       Boolean            @default(false)
  is_number_verified      Boolean            @default(false)
  pan_card_url            String?
  driver_license_url      String?
  created_at              DateTime           @default(now())
  is_deleted              Boolean            @default(false)
  is_deleted_by           Int?
  status                  DriverStatus       @default(Banned)
  updated_at              DateTime           @updatedAt
  formated_id             String             @unique
  vendor_id               Int
  vehicle_id              Int?
  alternate_mobile_number String             @db.VarChar(20)
  driver_name             String             @db.VarChar(255)
  mobile_number           String             @db.VarChar(20)
  aadhar_card_url         String?
  driver_image_url        String?
  end_location_id         Int?
  start_location_id       Int?
  availability_status     AvailabilityStatus @default(Onboard_Pending)
  sub_service_id          Int?
  average_rating          Float              @default(0)
  total_reviews           Int                @default(0)
  startLocation           location?          @relation("DriverStartLocation", fields: [start_location_id], references: [id])
  endLocation             location?          @relation("DriverEndLocation", fields: [end_location_id], references: [id])
  vehicle                 vehicle?           @relation(fields: [vehicle_id], references: [id])
  vendor                  vendor             @relation(fields: [vendor_id], references: [id])
  orders                  order[]

  @@index([vendor_id])
  @@index([vehicle_id])
  @@index([start_location_id])
  @@index([end_location_id])
  @@index([email, is_deleted])
  @@index([mobile_number, is_deleted])
}

model vehicle {
  id                  Int                @id @default(autoincrement())
  fleet_type          Int
  vendor_id           Int
  fleet_location      String             @db.VarChar(255)
  registration_number String             @db.VarChar(20)
  make                String             @db.VarChar(255)
  model               String             @db.VarChar(255)
  owner_name          String             @db.VarChar(255)
  chassis_number      String             @db.VarChar(255)
  engine_number       String             @db.VarChar(255)
  vehicle_validity    DateTime
  insurance_validity  DateTime
  fitness_validity    DateTime
  puc_validity        DateTime
  vehical_image_url   String[]
  chassis_image_url   String?
  tax_image_url       String?
  insurance_image_url String?
  fitness_image_url   String?
  puc_image_url       String?
  is_deleted          Boolean            @default(false)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt
  vehicle_class       String?            @db.VarChar(255)
  status              VehicleStatus      @default(Banned)
  availability_status AvailabilityStatus @default(Onboard_Pending)
  drivers             driver[]
  vendor              vendor             @relation(fields: [vendor_id], references: [id])
  orders              order[]

  @@index([id])
  @@index([vendor_id])
}

model customer {
  id                 Int                @id @default(autoincrement())
  formated_id        String             @unique
  full_name          String             @db.VarChar(255)
  is_verified        Boolean            @default(false)
  number             String             @db.VarChar(20)
  email              String             @db.VarChar(255)
  is_deleted         Boolean            @default(false)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @default(now()) @updatedAt
  is_deleted_by      Int?
  average_rating     Float              @default(0)
  total_reviews      Int                @default(0)
  customer_vehicles  customer_vehicle[]
  orders             order[]
  customer_addresses customer_address[]
  created_vouchers   voucher[]          @relation("VoucherCreator")
  redeemed_vouchers  voucher[]          @relation("VoucherRedeemer")
  scheduled_orders   scheduled_order[]
}

model customer_vehicle {
  id                  Int      @id @default(autoincrement())
  customer_id         Int
  make                String   @db.VarChar(255)
  model               String   @db.VarChar(255)
  registration_number String   @db.VarChar(20)
  class               String   @db.VarChar(255)
  fuel_type           FuelType
  is_deleted          Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt
  is_deleted_by       Int?
  customer            customer @relation(fields: [customer_id], references: [id])
  orders              order[]

  @@index([customer_id])
}

model location {
  id           Int              @id @default(autoincrement())
  address      String?
  street       String?
  area         String?
  city         String?
  state        String?
  pincode      String?
  country      String?
  latitude     Float
  longitude    Float
  landmark     String?
  description  String?
  place_id     String
  category     LocationCategory @default(Driver)
  created_at   DateTime         @default(now())
  startDrivers driver[]         @relation("DriverStartLocation")
  endDrivers   driver[]         @relation("DriverEndLocation")

  @@index([city])
  @@index([state])
  @@index([category])
  @@index([place_id])
}

model customer_address {
  id          Int      @id @default(autoincrement())
  customer_id Int
  label       String // e.g., "Home", "Work", "Office"
  is_default  Boolean  @default(false)
  address     String?
  street      String?
  area        String?
  city        String?
  state       String?
  pincode     String?
  country     String?
  latitude    Float
  longitude   Float
  landmark    String?
  description String?
  place_id    String
  name        String   @default("")
  number      String   @default("")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  customer customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([place_id])
}

model order {
  id                  Int         @id @default(autoincrement())
  formated_id         String      @unique
  customer_id         Int
  customer_vehicle_id Int?
  vendor_id           Int?
  driver_id           Int?
  vehicle_id          Int?
  service_id          Int
  sub_service_id      Int?
  fleet_type          Int
  status              OrderStatus @default(New)
  assign_time         DateTime?
  start_time          DateTime?
  completion_time     DateTime?
  remarks             String?
  cancel_reason       String?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @default(now()) @updatedAt

  meta_data Json?

  pre_booked_images String[] @default([])

  pre_pickup_images  String[] @default([])
  post_pickup_images String[] @default([])

  dropoff_images String[] @default([])

  is_physical_vcrf_for_pickup  Boolean @default(true)
  is_physical_vcrf_for_dropoff Boolean @default(true)
  physical_pickup_vcrf_image   String?
  physical_dropoff_vcrf_image  String?

  applied_voucher_id Int?
  discount_amount    Float  @default(0.0)
  final_amount       Float? // Net billing price after discount
  scheduled_order_id Int? // Populated when promoted from a scheduled booking

  customer         customer          @relation(fields: [customer_id], references: [id])
  customer_vehicle customer_vehicle? @relation(fields: [customer_vehicle_id], references: [id])
  vendor           vendor?           @relation(fields: [vendor_id], references: [id])
  driver           driver?           @relation(fields: [driver_id], references: [id])
  vehicle          vehicle?          @relation(fields: [vehicle_id], references: [id])
  locations        order_location[]
  service          service           @relation(fields: [service_id], references: [id])
  sub_service      sub_service?      @relation(fields: [sub_service_id], references: [id])
  otps             order_otp[]
  voucher          voucher?          @relation(fields: [applied_voucher_id], references: [id])
  scheduled_order  scheduled_order?  @relation(fields: [scheduled_order_id], references: [id])
  pickup_evcrf     pickup_evcrf?
  dropoff_evcrf    dropoff_evcrf?
  dispatches       order_dispatch[]
  reviews           review[]

  @@index([customer_id])
  @@index([driver_id])
  @@index([status, created_at])
  @@index([vehicle_id])
  @@index([vendor_id])
  @@index([applied_voucher_id])
  @@index([scheduled_order_id])
}

model order_location {
  id       Int          @id @default(autoincrement())
  order_id Int
  type     LocationType

  address   String?
  street    String?
  area      String?
  city      String?
  state     String?
  pincode   String?
  country   String?
  latitude  Float
  longitude Float
  landmark  String?
  place_id  String

  contact_name   String? @db.VarChar(255)
  contact_number String? @db.VarChar(20)

  created_at DateTime @default(now())

  order order @relation(fields: [order_id], references: [id])

  @@unique([order_id, type])
  @@index([order_id])
  @@index([place_id])
}

model order_otp {
  id          Int          @id @default(autoincrement())
  order_id    Int
  type        OrderOtpType @default(BREAKDOWN)
  otp         String       @db.VarChar(6)
  expires_at  DateTime
  verified_at DateTime?
  is_verified Boolean      @default(false)
  attempts    Int          @default(0)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @default(now()) @updatedAt

  order order @relation(fields: [order_id], references: [id])

  @@unique([order_id, type])
  @@index([order_id])
}

model logs {
  id               Int        @id @default(autoincrement())
  date             DateTime   @default(now())
  time_stamp       Int
  url              String
  method           HttpMethod
  success          Boolean
  status_code      Int
  res_time         Int
  res_message      String?
  error            String?    @db.Text // null on success
  error_stack      String?    @db.Text // full stack trace, only on errors
  req_body         Json?
  req_query_params Json?
  req_header       Json? // authorization header is excluded (stored in raw_token)
  req_files        Json? // multipart file metadata only (no binary)
  req_content_type String? // e.g. "application/json" | "multipart/form-data"
  res_body         Json?
  raw_token        String? // raw Bearer token from Authorization header
  decoded_token    Json? // decoded JWT payload
  user_role        Role?
  user_id          Int?
  user_formated_id String?
  user_agent       String?
  ip_address       String?
  endpoint_group   String? // auto-derived from URL first segment, e.g. "driver", "vendor"
  meta_data        Json? // debug data set by business services via CallerService.setMeta()

  @@index([date])
  @@index([success, status_code])
  @@index([user_id, user_role])
  @@index([endpoint_group])
}

model service {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  sub_services sub_service[]
  orders       order[]
  vendors      vendor[]
}

model sub_service {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  service_id Int
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  fix_distance Float @default(0)
  fix_price    Float @default(0)
  extra_price  Float @default(0)
  ton          Float @default(0)

  image_url    String?
  journey_type JourneyType @default(FourWay)

  service service @relation(fields: [service_id], references: [id])
  orders  order[]

  conditions sub_service_condtion[]

  @@unique([name, service_id])
}

model sub_service_condtion {
  id             Int    @id @default(autoincrement())
  sub_service_id Int
  condition      String

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  sub_service sub_service @relation(fields: [sub_service_id], references: [id])

  @@index([sub_service_id])
}

model wallet {
  id      Int   @id @default(autoincrement())
  user_id Int
  balance Float @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model wallet_transaction {
  id        Int @id @default(autoincrement())
  user_id   Int
  wallet_id Int

  amount                    Float           @default(0)
  transaction_type          TransactionType
  before_transaction_amount Float           @default(0)
  after_transaction_amount  Float           @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model voucher {
  id               Int       @id @default(autoincrement())
  user_id          Int
  code             String    @unique
  has_expired      Boolean   @default(false)
  discount_percent Float     @default(10.0)
  used_by_id       Int?
  used_at          DateTime?

  type VoucherType @default(Basic)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  creator  customer  @relation("VoucherCreator", fields: [user_id], references: [id])
  redeemer customer? @relation("VoucherRedeemer", fields: [used_by_id], references: [id])
  orders   order[]

  @@index([user_id])
  @@index([used_by_id])
}

model scheduled_order {
  id              Int                  @id @default(autoincrement())
  idempotency_key String               @unique // UUID set at creation — prevents duplicate promotions
  customer_id     Int
  status          ScheduledOrderStatus @default(Pending)

  // Snapshot of the full CreateOrderDto payload stored at booking time
  payload Json

  scheduled_at DateTime
  timezone     String   @default("Asia/Kolkata")

  // Execution tracking
  attempt_count     Int       @default(0)
  max_attempts      Int       @default(3)
  last_attempted_at DateTime?
  last_error        String?   @db.Text
  promoted_order_id Int?      @unique // FK to order.id on successful promotion
  cancelled_at      DateTime?
  cancel_reason     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer customer @relation(fields: [customer_id], references: [id])
  orders   order[]

  @@index([status, scheduled_at])
  @@index([customer_id])
}

model order_dispatch {
  id          Int                 @id @default(autoincrement())
  order_id    Int
  vendor_id   Int
  rank        Int // 1 = closest vendor, 2 = second closest, etc.
  status      DispatchRoundStatus @default(Pending)
  notified_at DateTime? // When this vendor's drivers were first notified
  expires_at  DateTime? // notified_at + 2 minutes — when this round ends
  accepted_at DateTime? // Set when a driver from this vendor accepts

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  order  order  @relation(fields: [order_id], references: [id])
  vendor vendor @relation(fields: [vendor_id], references: [id])

  @@index([order_id, rank])
  @@index([order_id, status])
  @@index([status, expires_at]) // Used by the escalation cron to find expired rounds
}

model review {
  id            Int            @id @default(autoincrement())
  order_id      Int
  reviewer_type ReviewUserType
  reviewer_id   Int
  reviewee_type ReviewUserType
  reviewee_id   Int
  rating        Int
  title         String?        @db.VarChar(150)
  comment       String?        @db.Text
  tags          Json?
  is_anonymous  Boolean        @default(false)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  order order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, reviewer_type, reviewer_id])
  @@index([order_id])
  @@index([reviewee_type, reviewee_id])
}

//#region enums

enum DispatchRoundStatus {
  Pending // Vendor is in the queue but not yet notified
  Active // Vendor's drivers are currently being shown the order
  Skipped // 2-minute window elapsed, no driver accepted
  Accepted // A driver from this vendor accepted the order
}

enum ScheduledOrderStatus {
  Pending
  Processing
  Promoted
  Failed
  Cancelled
  Expired
}

enum VoucherType {
  Enterprise
  Basic
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum JourneyType {
  FourWay
  ThreeWay
}

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}

enum OtpType {
  Number
  Email
}

enum VendorStatus {
  Pending
  Approved
}

enum DriverStatus {
  Available
  Busy
  UnderApproval
  Banned
}

enum FuelType {
  Petrol
  Diesel
  CNG
  Electric
  Hybrid
  LPG
}

enum Role {
  SuperAdmin
  Admin
  Vendor
  Driver
  Customer
}

enum OrganizationType {
  SoleProprietorship
  Partnership
  Corporation
  LimitedLiabilityCompany
  Cooperative
}

enum SignatureType {
  Upload
  E_Sign
}

enum LocationCategory {
  Driver
  Order
}

enum OrderStatus {
  New
  Assigned
  OtpPending
  InProgress
  Completed
  Closed
}

enum LocationType {
  Start
  Breakdown
  Drop
  End
}

enum OrderOtpType {
  BREAKDOWN
  DROP
}

enum AvailabilityStatus {
  Available
  Unavailable
  Onboard_Pending @map("Onboard Pending")
}

enum VehicleStatus {
  Available
  UnderApproval
  Banned
}

model pickup_evcrf {
  id                    Int     @id @default(autoincrement())
  order_id              Int     @unique
  fuel_amount           String? @db.VarChar(50)
  odometer_reading_text String? @db.VarChar(100)
  odometer_image        String? @db.Text
  driver_image          String? @db.Text
  driver_sign           String? @db.Text
  remarks               String? @db.Text
  selected_accessories  Json?

  date_and_time          String? @db.VarChar(255)
  service_type           String? @db.VarChar(255)
  vehicle_brand          String? @db.VarChar(255)
  vehicle_model          String? @db.VarChar(255)
  vehicle_no             String? @db.VarChar(255)
  customer_ph_no         String? @db.VarChar(50)
  driver_name            String? @db.VarChar(255)
  driver_ph_no           String? @db.VarChar(50)
  reaching_date_and_time String? @db.VarChar(255)
  event_type             String? @db.VarChar(255)
  event_location         String? @db.VarChar(255)
  vehicle_state          Json?

  meta                           Json?
  vehicle_class_configuration_id Int?
  created_at                     DateTime @default(now())
  updated_at                     DateTime @default(now()) @updatedAt

  order                       order                        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  vehicle_class_configuration vehicle_class_configuration? @relation(fields: [vehicle_class_configuration_id], references: [id])
  damages                     pickup_evcrf_damage[]

  @@index([order_id])
  @@index([vehicle_class_configuration_id])
}

model pickup_evcrf_damage {
  id              Int      @id @default(autoincrement())
  pickup_evcrf_id Int
  damage_number   Int
  image_url       String   @db.Text
  created_at      DateTime @default(now())

  pickup_evcrf pickup_evcrf @relation(fields: [pickup_evcrf_id], references: [id], onDelete: Cascade)

  @@index([pickup_evcrf_id])
}

model dropoff_evcrf {
  id       Int     @id @default(autoincrement())
  order_id Int     @unique
  remarks  String? @db.Text

  handover_name          String? @db.VarChar(255)
  drop_location          String? @db.VarChar(255)
  droping_type           String? @db.VarChar(255)
  dropping_date_and_time String? @db.VarChar(255)
  handover_image         String? @db.Text
  handover_signature     String? @db.Text

  dynamic_fields Json?
  meta           Json?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  order order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
}

model vehicle_class_configuration {
  id                  Int                       @id @default(autoincrement())
  mapped_class        String                    @unique @db.VarChar(255)
  sub_classes         String[]                  @default([])
  accessories         vehicle_class_accessory[]
  diagram_image_url   String                    @db.Text
  total_damage_points Int
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @default(now()) @updatedAt
  pickup_evcrfs       pickup_evcrf[]
  vehicle_states      vehicle_state[]
}

model vehicle_class_accessory {
  id                             Int      @id @default(autoincrement())
  vehicle_class_configuration_id Int
  name                           String   @db.VarChar(255)
  created_at                     DateTime @default(now())
  updated_at                     DateTime @default(now()) @updatedAt

  vehicle_class_configuration vehicle_class_configuration @relation(fields: [vehicle_class_configuration_id], references: [id])

  @@index([vehicle_class_configuration_id])
}

model vehicle_state {
  id                             Int      @id @default(autoincrement())
  vehicle_class_configuration_id Int
  name                           String   @db.VarChar(255)
  created_at                     DateTime @default(now())
  updated_at                     DateTime @default(now()) @updatedAt

  vehicle_class_configuration vehicle_class_configuration @relation(fields: [vehicle_class_configuration_id], references: [id])
  options                     vehicle_state_option[]

  @@index([vehicle_class_configuration_id])
}

model vehicle_state_option {
  id               Int      @id @default(autoincrement())
  vehicle_state_id Int
  name             String   @db.VarChar(255)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  vehicle_state vehicle_state @relation(fields: [vehicle_state_id], references: [id])

  @@index([vehicle_state_id])
}

enum ReviewUserType {
  Customer
  Driver
}
